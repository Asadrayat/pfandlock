# Copy to .env and fill in. `shopify app dev` writes SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES for you from the linked app,
# so in local dev you usually only need DATABASE_URL. A deployed host (Docker,
# Fly, Render, ...) has no CLI, so every required variable below must be set
# there by hand.

# --- Required ---

# Postgres connection string (prisma/schema.prisma sets provider =
# "postgresql"). `npm run setup` runs `prisma migrate deploy` against it.
DATABASE_URL=postgresql://user:password@localhost:5432/pfandlock

# Client credentials of the Partner app. The client_id in shopify.app.toml is
# the same value as SHOPIFY_API_KEY; the secret is only in the Partner
# Dashboard - never commit it.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS origin Shopify redirects back to and embeds the app from. Must
# match application_url in shopify.app.toml. In dev the CLI overwrites this
# with the current tunnel URL on every run.
SHOPIFY_APP_URL=https://your-app.example.com

# Must stay in sync with `scopes` in shopify.app.toml - a mismatch means
# merchants get prompted for the wrong set of permissions.
SCOPES=write_products,write_cart_transforms,read_themes

# --- Optional ---

# Port the app server listens on (app/routes are served by react-router-serve;
# the Dockerfile exposes 3000).
PORT=3000

# Vite HMR port used by `shopify app dev`. Only worth setting if 8002 clashes.
# FRONTEND_PORT=8002

# Set only for a shop on a custom domain that isn't *.myshopify.com - it's
# added to customShopDomains in app/shopify.server.ts so auth accepts it.
# SHOP_CUSTOM_DOMAIN=shop.example.com

# The CLI sets HOST instead of SHOPIFY_APP_URL on older setups; vite.config.ts
# migrates it across at startup. Don't set it yourself.
# HOST=
